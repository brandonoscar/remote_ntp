<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Helixis Branding -->
  <title>Helixis Browser</title>

  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #0f172a;
      color: #e5e7eb;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }

    .container {
      text-align: center;
      padding: 36px 28px;
      border-radius: 24px;
      background: #020617;
      box-shadow: 0 0 30px rgba(0,0,0,.45);
      border: 1px solid #1e293b;
      width: 520px;
      max-width: 92%;
    }

    h1 {
      margin-bottom: 6px;
      font-size: 32px;
      letter-spacing: .5px;
    }

    .tagline {
      font-size: 14px;
      opacity: .85;
      margin-bottom: 20px;
    }

    .search-box {
      margin-top: 14px;
    }

    input {
      width: 92%;
      padding: 12px;
      font-size: 15px;
      border-radius: 10px;
      border: 1px solid #334155;
      background: #020617;
      color: #e5e7eb;
      outline: none;
    }

    input:focus {
      border-color: #22c55e;
    }

    .footer {
      margin-top: 16px;
      font-size: 12px;
      opacity: .7;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1>Helixis Browser</h1>

    <div class="tagline">
      Agentic Workflows • Unified Tools • Built for Operators
    </div>

    <div class="search-box">
      <input
        id="searchBox"
        type="text"
        placeholder="Search the web or enter a URL"
        autofocus
      />
    </div>

    <div class="footer">
      Helixis Labs — 2026
    </div>
  </div>

  <script>
    // Simple search handler (same behavior as Rebel NTP)
    const box = document.getElementById("searchBox");

    box.addEventListener("keydown", e => {
      if (e.key === "Enter") {
        const value = box.value.trim();

        if (value.startsWith("http://") || value.startsWith("https://")) {
          window.location.href = value;
        } else if (value.includes(".")) {
          window.location.href = "https://" + value;
        } else {
          window.location.href =
            "https://www.google.com/search?q=" + encodeURIComponent(value);
        }
      }
    });
  </script>

</body>
</html>

